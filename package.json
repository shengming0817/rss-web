{
  "name": "rss-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=11.4.0"
  },
  "scripts": {
    "dev": "pnpm -F @rss/web dev",
    "build": "pnpm -F @rss/web build && pnpm check:identity:build && pnpm check:preview:build",
    "build:preview:demo": "VITE_CONFIG_CATALOG_PREVIEW=true VITE_CONFIG_HISTORY_PREVIEW=true VITE_ROLE_BINDINGS_PREVIEW=true pnpm -F @rss/web exec vite build --mode demo --outDir dist-preview-demo && node scripts/check-built-preview.mjs apps/web/dist-preview-demo demo",
    "check:identity:build": "node scripts/check-built-identity.mjs apps/web/dist",
    "check:preview:build": "node scripts/check-built-preview.mjs apps/web/dist",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --project '!root'",
    "test:boundary": "vitest run --project root",
    "test:e2e": "playwright test",
    "test:edge": "node e2e/edge/smoke.mjs",
    "test:e2e:real": "node e2e/real/run.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vue-tsc": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vue/test-utils": "catalog:",
    "jsdom": "catalog:",
    "@playwright/test": "catalog:",
    "eslint": "catalog:",
    "@eslint/js": "catalog:",
    "typescript-eslint": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "vue-eslint-parser": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-vuejs-accessibility": "catalog:",
    "eslint-config-prettier": "catalog:",
    "prettier": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:"
  }
}

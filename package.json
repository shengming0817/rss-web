{
  "name": "rss-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11.4.0"
  },
  "scripts": {
    "typecheck": "node scripts/ensure-contracts.mjs && pnpm -r --if-present typecheck",
    "lint": "node scripts/ensure-contracts.mjs && eslint .",
    "lint:fix": "node scripts/ensure-contracts.mjs && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/ensure-contracts.mjs && vitest run",
    "test:coverage": "node scripts/ensure-contracts.mjs && pnpm -r --no-bail --filter @rss/api --filter @rss/auth --filter @rss/auth-core --filter @rss/auth-http --filter @rss/mdm-authorization --filter @rss/mdm-tenant-administration --filter @rss/mdm-user-profiles --filter @rss/mdm-devices --filter @rss/mdm-enrollment --filter @rss/mdm-connections --filter @rss/mdm-inventory --filter @rss/mdm-policies --filter @rss/mdm-tenant-setup --filter @rss/mdm-runtime-diagnostics --filter @rss/mdm-telemetry --filter @rss/mdm-scopes --filter @rss/mdm-groups --filter @rss/mdm-compliance --filter @rss/mdm-resources --filter @rss/mdm-content --filter @rss/mdm-software --filter @rss/mdm-certificates --filter @rss/mdm-recovery-credentials --filter @rss/mdm-audit --filter @rss/mdm-webhooks --filter @rss/mdm-execution --filter @rss/mdm-device-access --filter @rss/mdm-http --filter @rss/core --filter @rss/device-access --filter @rss/device-access-app run test:coverage",
    "test:boundary": "node scripts/ensure-contracts.mjs && vitest run --project root && node --test e2e/mdm/enrollment-callback.test.mjs e2e/mdm/device-run.test.mjs",
    "prepare": "husky && node scripts/ensure-contracts.mjs",
    "test:identity:joint": "node e2e/identity/run.mjs",
    "check:identity-app:build": "node scripts/check-identity-app-build.mjs",
    "build:identity": "pnpm -F @rss/identity-app build && pnpm check:identity-app:build",
    "image:identity": "bash scripts/build-identity-image.sh",
    "dev": "pnpm -F @rss/identity-app dev",
    "build": "pnpm build:identity && pnpm build:mdm && pnpm build:device-access",
    "dev:identity": "pnpm -F @rss/identity-app dev",
    "build:mdm": "pnpm -F @rss/mdm-app build",
    "image:mdm": "bash scripts/build-mdm-image.sh",
    "dev:ui": "pnpm -F @rss/ui-preview dev",
    "build:ui-preview": "pnpm -F @rss/ui-preview build",
    "dev:device-access": "pnpm -F @rss/device-access-app dev",
    "dev:device-access:demo": "pnpm -F @rss/device-access-app demo",
    "build:device-access": "pnpm -F @rss/device-access-app build && node scripts/check-device-access-app-build.mjs",
    "generate:contracts": "node scripts/ensure-contracts.mjs --force",
    "check:contracts": "node scripts/ensure-contracts.mjs --check",
    "test:contracts": "node --test scripts/contract-source.test.mjs",
    "dev:mdm": "pnpm -F @rss/mdm-app dev",
    "test:mdm:react-auth-browser": "node e2e/mdm/react-auth-run.mjs",
    "test:mdm:react-administration-browser": "node e2e/mdm/react-administration-run.mjs",
    "test:mdm:react-devices-enrollment-browser": "node e2e/mdm/react-devices-enrollment-run.mjs",
    "test:mdm:react-assets-browser": "node e2e/mdm/react-assets-run.mjs",
    "test:mdm:react-software-browser": "node e2e/mdm/react-software-run.mjs",
    "test:mdm:react-certificates-browser": "node e2e/mdm/react-certificates-run.mjs",
    "test:mdm:react-audit-webhooks-browser": "node e2e/mdm/react-audit-webhooks-run.mjs",
    "test:mdm:react-policy-browser": "node e2e/mdm/react-policy-run.mjs",
    "test:mdm:react-execution-access-browser": "node e2e/mdm/react-execution-access-run.mjs",
    "test:mdm:react-telemetry-browser": "node e2e/mdm/react-telemetry-run.mjs",
    "dev:mdm:diagnostics:demo": "pnpm -F @rss/mdm-app exec vite --config demo/vite.config.ts --host 127.0.0.1",
    "test:mdm:react-setup-browser": "node e2e/mdm/react-setup-run.mjs",
    "test:mdm:react-diagnostics-demo-browser": "node e2e/mdm/react-diagnostics-demo-run.mjs"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vue-tsc": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vue/test-utils": "catalog:",
    "jsdom": "catalog:",
    "eslint": "catalog:",
    "@eslint/js": "catalog:",
    "typescript-eslint": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "vue-eslint-parser": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-vuejs-accessibility": "catalog:",
    "eslint-config-prettier": "catalog:",
    "prettier": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "@rss/auth": "workspace:*",
    "@rss/api": "workspace:*",
    "playwright": "catalog:",
    "ajv": "catalog:",
    "json-schema-to-typescript": "catalog:",
    "esbuild": "catalog:",
    "vuetify": "catalog:",
    "vite": "catalog:"
  }
}

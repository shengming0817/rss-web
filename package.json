{
  "name": "rss-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11.4.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "pnpm -r --no-bail --filter @rss/api --filter @rss/auth --filter @rss/mdm-app --filter @rss/core --filter @rss/device-access --filter @rss/device-access-app run test:coverage",
    "test:boundary": "vitest run --project root && node --test e2e/mdm/enrollment-callback.test.mjs e2e/mdm/device-run.test.mjs",
    "prepare": "husky",
    "test:mdm:joint": "vitest run --config e2e/mdm/vitest.config.ts",
    "test:identity:joint": "node e2e/identity/run.mjs",
    "check:identity-app:build": "node scripts/check-identity-app-build.mjs",
    "build:identity": "pnpm -F @rss/identity-app build && pnpm check:identity-app:build",
    "image:identity": "bash scripts/build-identity-image.sh",
    "dev": "pnpm -F @rss/identity-app dev",
    "build": "pnpm build:identity && pnpm build:mdm && pnpm build:device-access",
    "dev:identity": "pnpm -F @rss/identity-app dev",
    "dev:mdm": "pnpm -F @rss/mdm-app dev",
    "dev:mdm:demo": "pnpm -F @rss/mdm-app demo",
    "build:mdm": "pnpm -F @rss/mdm-app build && node scripts/check-mdm-app-build.mjs",
    "image:mdm": "bash scripts/build-mdm-image.sh",
    "test:mdm:policy-browser": "node e2e/mdm/policy-browser.mjs",
    "test:mdm:enrollment-browser": "node e2e/mdm/enrollment-run.mjs",
    "test:mdm:operations-browser": "node e2e/mdm/operations-run.mjs",
    "test:mdm:device-browser": "node e2e/mdm/device-run.mjs",
    "dev:ui": "pnpm -F @rss/ui-preview dev",
    "build:ui-preview": "pnpm -F @rss/ui-preview build",
    "test:mdm:software-browser": "node e2e/mdm/software-run.mjs",
    "test:mdm:settings-browser": "node e2e/mdm/settings-run.mjs",
    "test:mdm:profiles-browser": "node e2e/mdm/profiles-run.mjs",
    "test:mdm:telemetry-browser": "node e2e/mdm/telemetry-run.mjs",
    "test:mdm:console-browser": "node e2e/mdm/console-run.mjs",
    "dev:device-access": "pnpm -F @rss/device-access-app dev",
    "dev:device-access:demo": "pnpm -F @rss/device-access-app demo",
    "build:device-access": "pnpm -F @rss/device-access-app build && node scripts/check-device-access-app-build.mjs",
    "generate:contracts": "node scripts/generate-contracts.mjs",
    "check:contracts": "node scripts/generate-contracts.mjs --check",
    "test:contracts": "node --test scripts/contract-source.test.mjs"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vue-tsc": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vue/test-utils": "catalog:",
    "jsdom": "catalog:",
    "eslint": "catalog:",
    "@eslint/js": "catalog:",
    "typescript-eslint": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "vue-eslint-parser": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-vuejs-accessibility": "catalog:",
    "eslint-config-prettier": "catalog:",
    "prettier": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "@rss/auth": "workspace:*",
    "@rss/api": "workspace:*",
    "playwright": "catalog:",
    "ajv": "catalog:",
    "json-schema-to-typescript": "catalog:",
    "esbuild": "catalog:"
  }
}

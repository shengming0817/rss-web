  "schema": {
    "$defs": {
      "CapabilitySelector": {
        "description": "Explicit exact address in the authenticated tenant's Policy namespace.",
        "oneOf": [
          {
            "additionalProperties": false,
            "description": "Canonical Policy identity.",
            "properties": {
              "id": {
                "description": "Object ID.",
                "format": "uuid",
                "type": "string"
              },
              "kind": {
                "const": "id",
                "type": "string"
              }
            },
            "required": ["kind", "id"],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "Server-generated tool name.",
            "properties": {
              "kind": {
                "const": "tool_name",
                "type": "string"
              },
              "name": {
                "description": "Complete canonical name.",
                "type": "string"
              }
            },
            "required": ["kind", "name"],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "Administrator-controlled unique alias.",
            "properties": {
              "alias": {
                "$ref": "#/$defs/PolicyAlias",
                "description": "Canonical tenant-local alias."
              },
              "kind": {
                "const": "alias",
                "type": "string"
              }
            },
            "required": ["kind", "alias"],
            "type": "object"
          }
        ]
      },
      "Digest": {
        "description": "Lowercase SHA-256 bytes expressed as hex; a digest alone grants no trust.",
        "maxLength": 64,
        "minLength": 64,
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "EntryAction": {
        "description": "The external link selects a view or prepares an original user interface.",
        "oneOf": [
          {
            "const": "view",
            "description": "Read/open only.",
            "type": "string"
          },
          {
            "const": "invoke",
            "description": "Open the exact input summary; a real user must submit it.",
            "type": "string"
          }
        ]
      },
      "EntryNamespace": {
        "additionalProperties": false,
        "description": "Enterprise coordinates are compared with the active registration, never used to switch it.",
        "properties": {
          "device": {
            "description": "Exact device identity.",
            "type": "string"
          },
          "generation": {
            "description": "Exact registration generation.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "instance": {
            "description": "Product instance identity, not a server URL.",
            "type": "string"
          },
          "registration": {
            "description": "Exact registration UUID.",
            "type": "string"
          },
          "tenant": {
            "description": "Exact tenant UUID.",
            "type": "string"
          }
        },
        "required": ["instance", "tenant", "device", "registration", "generation"],
        "type": "object"
      },
      "EntrySelector": {
        "description": "Explicit address kinds; display names are not exact selectors.",
        "oneOf": [
          {
            "additionalProperties": false,
            "description": "One packaged local tool; its existing owner supplies schema and qualification.",
            "properties": {
              "kind": {
                "const": "localTool",
                "type": "string"
              },
              "name": {
                "$ref": "#/$defs/LocalTool",
                "description": "Stable tool name."
              }
            },
            "required": ["kind", "name"],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "Stable page or page section.",
            "properties": {
              "id": {
                "description": "Explicit owner-registered ID.",
                "type": "string"
              },
              "kind": {
                "const": "node",
                "type": "string"
              }
            },
            "required": ["kind", "id"],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "Server-owned ID, tool name or unique alias.",
            "properties": {
              "kind": {
                "const": "capability",
                "type": "string"
              },
              "selector": {
                "$ref": "#/$defs/CapabilitySelector",
                "description": "Canonical producer selector."
              }
            },
            "required": ["kind", "selector"],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "Explicit one-to-many event, never an alias lookup.",
            "properties": {
              "kind": {
                "const": "event",
                "type": "string"
              },
              "name": {
                "$ref": "#/$defs/PolicyEventName",
                "description": "Producer-normalized name."
              }
            },
            "required": ["kind", "name"],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "Original preparation or execution.",
            "properties": {
              "kind": {
                "const": "request",
                "type": "string"
              },
              "request": {
                "$ref": "#/$defs/RequestId",
                "description": "Original business request."
              }
            },
            "required": ["kind", "request"],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "Exact periodic collection session.",
            "properties": {
              "kind": {
                "const": "sampling",
                "type": "string"
              },
              "query": {
                "$ref": "#/$defs/QueryRef",
                "description": "Original definition and revision."
              }
            },
            "required": ["kind", "query"],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "Original source-qualified management fact.",
            "properties": {
              "id": {
                "description": "Producer fact identity.",
                "type": "string"
              },
              "kind": {
                "const": "activity",
                "type": "string"
              }
            },
            "required": ["kind", "id"],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "Existing producer batch.",
            "properties": {
              "id": {
                "description": "Canonical batch UUID.",
                "type": "string"
              },
              "kind": {
                "const": "batch",
                "type": "string"
              }
            },
            "required": ["kind", "id"],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "Original remote execution and attempt.",
            "properties": {
              "attempt": {
                "description": "Exact attempt UUID.",
                "type": "string"
              },
              "kind": {
                "const": "task",
                "type": "string"
              },
              "task": {
                "description": "Backend task UUID.",
                "type": "string"
              }
            },
            "required": ["kind", "task", "attempt"],
            "type": "object"
          }
        ]
      },
      "Id": {
        "description": "Opaque local reference identifier; syntax validity is not authenticity.",
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
        "type": "string"
      },
      "LocalTool": {
        "description": "Stable names for actual existing local operation owners.",
        "oneOf": [
          {
            "const": "network.check",
            "description": "Existing finite DNS/TCP diagnostic.",
            "type": "string"
          },
          {
            "const": "system.settings",
            "description": "Existing local settings owner.",
            "type": "string"
          },
          {
            "const": "software.manage",
            "description": "Existing software preparation/submission owner.",
            "type": "string"
          }
        ]
      },
      "PolicyAlias": {
        "description": "Tenant-local canonical Policy alias.",
        "type": "string"
      },
      "PolicyEventName": {
        "description": "Tenant-local event name shared by any number of Policies; never an object alias.",
        "type": "string"
      },
      "QueryRef": {
        "additionalProperties": false,
        "description": "Exact service-owned query definition.",
        "properties": {
          "id": {
            "$ref": "#/$defs/Id",
            "description": "Stable resource identity."
          },
          "revision": {
            "$ref": "#/$defs/Digest",
            "description": "Digest of the complete current definition."
          }
        },
        "required": ["id", "revision"],
        "type": "object"
      },
      "RequestId": {
        "description": "Local execution request identity.",
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "One bounded navigation intent; neither origin nor confirmation is accepted here.",
    "properties": {
      "action": {
        "$ref": "#/$defs/EntryAction",
        "description": "Requested navigation behavior."
      },
      "namespace": {
        "anyOf": [
          {
            "$ref": "#/$defs/EntryNamespace"
          },
          {
            "type": "null"
          }
        ],
        "description": "Mandatory for enterprise links; absent for purely local page nodes."
      },
      "parameters": {
        "additionalProperties": true,
        "description": "Non-secret suggestions; the current schema is checked before display/use.",
        "type": "object"
      },
      "revision": {
        "description": "Exact owner configuration revision when supplied.",
        "format": "uint64",
        "minimum": 0,
        "type": ["integer", "null"]
      },
      "selector": {
        "$ref": "#/$defs/EntrySelector",
        "description": "Shared exact selector."
      },
      "step": {
        "description": "Owner-qualified node inside the exact attempt.",
        "type": ["string", "null"]
      },
      "version": {
        "description": "Exact owner definition version when supplied.",
        "type": ["string", "null"]
      }
    },
    "required": ["action", "selector", "parameters"],
    "title": "EntryIntent",
    "type": "object"
  },

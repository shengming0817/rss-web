{
  "name": "@rss/mdm-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build --configLoader runner",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --maxWorkers=2",
    "demo": "vite --configLoader runner --mode demo --host 127.0.0.1"
  },
  "dependencies": {
    "@noble/hashes": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "vue-i18n": "catalog:",
    "pinia": "catalog:",
    "@rss/core": "workspace:*",
    "@rss/api": "workspace:*",
    "@rss/auth": "workspace:*",
    "vuetify": "catalog:"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "catalog:",
    "@types/node": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@vue/test-utils": "catalog:",
    "jsdom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "ajv": "catalog:"
  }
}

  "dependencies": {
    "vue": "catalog:",
    "vue-router": "catalog:",
    "vue-i18n": "catalog:",
    "pinia": "catalog:",
    "@rss/core": "workspace:*",
    "@rss/api": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "catalog:",
    "@types/node": "catalog:",
    "vite": "catalog:",
    "sass": "catalog:",
    "vitest": "catalog:",
    "@vue/test-utils": "catalog:",
    "jsdom": "catalog:",
    "@vitest/coverage-v8": "catalog:"
  }
}

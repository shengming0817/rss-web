{
  "name": "@rss/identity-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/ensure-contracts.mjs && vite build --watch",
    "build": "node ../../scripts/ensure-contracts.mjs && tsc --noEmit && vite build",
    "typecheck": "node ../../scripts/ensure-contracts.mjs && tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "node ../../scripts/ensure-contracts.mjs && vitest run",
    "test:coverage": "node ../../scripts/ensure-contracts.mjs && vitest run --coverage"
  },
  "dependencies": {
    "@rss/core": "workspace:*",
    "@rss/api": "workspace:*",
    "@rss/auth-core": "workspace:*",
    "@rss/auth-http": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "catalog:",
    "antd": "catalog:"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "jsdom": "catalog:",
    "@vitest/coverage-v8": "catalog:"
  }
}

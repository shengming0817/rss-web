{
  "name": "@rss/device-access-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/ensure-contracts.mjs && vite build --configLoader runner --watch",
    "demo": "node ../../scripts/ensure-contracts.mjs && vite --configLoader runner --mode demo --host 127.0.0.1 --port 4328 --strictPort",
    "build": "node ../../scripts/ensure-contracts.mjs && tsc --noEmit && vite build --configLoader runner",
    "typecheck": "node ../../scripts/ensure-contracts.mjs && tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "node ../../scripts/ensure-contracts.mjs && vitest run",
    "test:coverage": "node ../../scripts/ensure-contracts.mjs && vitest run --coverage"
  },
  "dependencies": {
    "@rss/api": "workspace:*",
    "@rss/device-access": "workspace:*",
    "@rss/core": "workspace:*",
    "react": "catalog:",
    "antd": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "catalog:",
    "@rss/auth-core": "workspace:*",
    "@rss/auth-http": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "typescript": "catalog:",
    "jsdom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@ant-design/static-style-extract": "catalog:"
  }
}

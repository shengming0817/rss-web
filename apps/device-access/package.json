{
  "name": "@rss/device-access-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/ensure-contracts.mjs && vite build --configLoader runner --watch",
    "demo": "node ../../scripts/ensure-contracts.mjs && vite --configLoader runner --mode demo --host 127.0.0.1 --port 4328 --strictPort",
    "build": "node ../../scripts/ensure-contracts.mjs && vue-tsc --noEmit && vite build --configLoader runner",
    "typecheck": "node ../../scripts/ensure-contracts.mjs && vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.node.json",
    "test": "node ../../scripts/ensure-contracts.mjs && vitest run",
    "test:coverage": "node ../../scripts/ensure-contracts.mjs && vitest run --coverage"
  },
  "dependencies": {
    "vue": "catalog:",
    "vue-router": "catalog:",
    "vue-i18n": "catalog:",
    "vuetify": "catalog:",
    "@rss/auth": "workspace:*",
    "@rss/api": "workspace:*",
    "@rss/device-access": "workspace:*",
    "@rss/core": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "catalog:",
    "@types/node": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:",
    "typescript": "catalog:",
    "@vue/test-utils": "catalog:",
    "jsdom": "catalog:",
    "@vitest/coverage-v8": "catalog:"
  }
}

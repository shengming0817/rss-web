pid /tmp/nginx.pid;
error_log stderr crit;
events { worker_connections 1024; }
http {
  include /etc/nginx/mime.types;
  # Deployment must replace this exact TOU-only frame allowlist with native origins.
  map $request_uri $mdm_frame_ancestors {
    default "'none'";
    ~^/enrollment/windows/entra/terms(?:\?.*)?$ "https://login.microsoftonline.com";
  }
  client_max_body_size 16k;
  large_client_header_buffers 4 8k;
  limit_req_zone $binary_remote_addr zone=mdm_login:10m rate=20r/m;
  limit_req_zone $binary_remote_addr zone=mdm_api:10m rate=10r/s;
  limit_req_status 429;
  limit_conn_zone $binary_remote_addr zone=mdm_peer_connections:10m;
  limit_conn_zone $server_name zone=mdm_server_connections:1m;
  limit_conn_status 429;
  # No URL, query, headers or body: OIDC callback URLs can contain credentials.
  log_format mdm_safe escape=json '{"request_id":"$request_id","upstream_request_id":"$upstream_http_x_request_id","status":$status,"upstream_status":"$upstream_status","latency_seconds":$request_time}';
  access_log /dev/stdout mdm_safe;
  client_body_temp_path /tmp/client_body;
  proxy_temp_path /tmp/proxy;
  fastcgi_temp_path /tmp/fastcgi;
  uwsgi_temp_path /tmp/uwsgi;
  scgi_temp_path /tmp/scgi;
  server {
    listen 8443 ssl;
    server_name mdm.example.test;
    ssl_certificate /run/config/tls.crt;
    ssl_certificate_key /run/config/tls.key;
    root /usr/share/nginx/html;
    ssl_protocols TLSv1.2 TLSv1.3;
    limit_conn mdm_peer_connections 8;
    limit_conn mdm_server_connections 128;
    client_header_timeout 10s;
    client_body_timeout 10s;
    send_timeout 10s;
    error_page 429 = @limited;
    location @limited {
      default_type application/json;
      add_header Cache-Control no-store always;
      add_header Retry-After 3 always;
      add_header Referrer-Policy no-referrer always;
      add_header X-Content-Type-Options nosniff always;
      add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;
      return 429 '{"code":"request_limited"}';
    }
    proxy_set_header Host mdm.example.test;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Forwarded "";
    proxy_set_header X-Real-IP "";
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Forwarded-Proto "";
    proxy_next_upstream off;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Cache-Control no-store always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors $mdm_frame_ancestors" always;
    location = /api/v1/identity-host/config.json { alias /run/config/identity-ui.json; default_type application/json; }
    location = /api/v1/mdm-host/config.json { alias /run/config/mdm-ui.json; default_type application/json; }
    location = /api/v1/identity/oidc/callback { limit_req zone=mdm_api burst=20 nodelay; proxy_pass http://mdm:8080; }
    location ~ ^/api/v1/identity/tenants/[^/]+/(login|session/reauthenticate)$ {
      limit_req zone=mdm_login burst=10 nodelay;
      proxy_pass http://mdm:8080;
    }
    location = /api/v1/certificate-archive/import {
      client_max_body_size 2m;
      limit_except POST { deny all; }
      limit_req zone=mdm_api burst=20 nodelay;
      proxy_pass http://mdm:8080;
    }
    # Exact authorization targets; PUT is the only write method in the current contract.
    location ~ "^/api/v1/authorization/(rules|user-groups)/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" {
      client_max_body_size 2m;
      limit_except PUT { deny all; }
      limit_req zone=mdm_api burst=20 nodelay;
      proxy_pass http://mdm:8080;
    }
    location ~ ^/api/v1/resources/[^/]+/(content|uploads/[^/]+)$ {
      client_max_body_size 16m;
      limit_req zone=mdm_api burst=20 nodelay;
      proxy_pass http://mdm:8080;
    }
    location ~ ^/api/v1/apple/organizations/[^/]+/ade/(configuration|operations)$ { client_max_body_size 256k; limit_req zone=mdm_api burst=20 nodelay; proxy_pass http://mdm:8080; }
    location ~ ^/api/v1/(identity/tenants/|identity-host/tenants/|mdm-candidate/|(?:authorization|devices|software-sources|certificate-archive|asset-fields|device-queries|saved-queries|groups|scopes|policies|compliance-rules|resources|software|enrollments|registration-quotas|agent-configurations|agent-configuration-operations|agent-enrollment-settings|apple/organizations|windows/entra/terms)(?:/|$)) { limit_req zone=mdm_api burst=20 nodelay; proxy_pass http://mdm:8080; }
    # Agent enrollment catalog is the only anonymous Agent listener surface.
    # Host must match the configured Agent origin; CA and SNI verification are mandatory.
    location ~ "^/api/v1/agent/enroll/packages(?:/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?:/content)?)?$" {
      limit_except GET { deny all; }
      limit_req zone=mdm_api burst=20 nodelay;
      proxy_pass_request_headers off;
      proxy_set_header Host agent.example.test:8447;
      proxy_set_header Accept $http_accept;
      proxy_set_header Range $http_range;
      proxy_set_header If-Range $http_if_range;
      proxy_set_header If-None-Match $http_if_none_match;
      proxy_set_header If-Modified-Since $http_if_modified_since;
      proxy_ssl_verify on;
      proxy_ssl_trusted_certificate /run/config/agent-ca.pem;
      proxy_ssl_server_name on;
      proxy_ssl_name agent.example.test;
      proxy_pass https://agent:8447;
    }
    location = /api/v1/self-enrollments { limit_except POST { deny all; } limit_req zone=mdm_api burst=20 nodelay; proxy_pass http://mdm:8080; }
    location = /api/v1/windows/entra-policy { client_max_body_size 128k; limit_req zone=mdm_api burst=20 nodelay; proxy_pass http://mdm:8080; }
    location = /.well-known/com.apple.remotemanagement { proxy_pass http://mdm:8080; }
    location ~ "^/api/v1/apple/account-enrollment/(authenticate(?:/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})?|finish|bridge\.js)$" { limit_req zone=mdm_api burst=20 nodelay; proxy_pass http://mdm:8080; }
    location = /livez { proxy_pass http://mdm:8080; }
    location = /readyz { proxy_pass http://mdm:8080; }
    location /api/ { return 404; }
    location / { try_files $uri $uri/ /index.html; }
  }
}

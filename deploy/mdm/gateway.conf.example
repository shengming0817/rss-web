pid /tmp/nginx.pid;
error_log stderr crit;
events { worker_connections 1024; }
http {
  include /etc/nginx/mime.types;
  client_max_body_size 16k;
  large_client_header_buffers 4 8k;
  limit_req_zone $binary_remote_addr zone=mdm_login:10m rate=20r/m;
  limit_req_zone $binary_remote_addr zone=mdm_api:10m rate=10r/s;
  limit_req_status 429;
  limit_conn_zone $binary_remote_addr zone=mdm_peer_connections:10m;
  limit_conn_zone $server_name zone=mdm_server_connections:1m;
  limit_conn_status 429;
  # No URL, query, headers or body: OIDC callback URLs can contain credentials.
  log_format mdm_safe escape=json '{"request_id":"$request_id","upstream_request_id":"$upstream_http_x_request_id","status":$status,"upstream_status":"$upstream_status","latency_seconds":$request_time}';
  access_log /dev/stdout mdm_safe;
  client_body_temp_path /tmp/client_body;
  proxy_temp_path /tmp/proxy;
  fastcgi_temp_path /tmp/fastcgi;
  uwsgi_temp_path /tmp/uwsgi;
  scgi_temp_path /tmp/scgi;
  server {
    listen 8443 ssl;
    server_name mdm.example.test;
    ssl_certificate /run/config/tls.crt;
    ssl_certificate_key /run/config/tls.key;
    root /usr/share/nginx/html;
    ssl_protocols TLSv1.2 TLSv1.3;
    limit_conn mdm_peer_connections 8;
    limit_conn mdm_server_connections 128;
    client_header_timeout 10s;
    client_body_timeout 10s;
    send_timeout 10s;
    error_page 429 = @limited;
    location @limited {
      default_type application/json;
      add_header Cache-Control no-store always;
      add_header Retry-After 3 always;
      add_header Referrer-Policy no-referrer always;
      add_header X-Content-Type-Options nosniff always;
      add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;
      return 429 '{"code":"request_limited"}';
    }
    proxy_set_header Host mdm.example.test;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Forwarded "";
    proxy_set_header X-Real-IP "";
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Forwarded-Proto "";
    proxy_next_upstream off;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Cache-Control no-store always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'" always;
    location = /api/identity-host/v1/config.json { alias /run/config/identity-ui.json; default_type application/json; }
    location = /api/mdm-host/v1/config.json { alias /run/config/mdm-ui.json; default_type application/json; }
    location = /api/v2/oidc/callback { limit_req zone=mdm_api burst=20 nodelay; proxy_pass http://mdm:8080; }
    location ~ ^/api/v2/tenants/[^/]+/(login|session/reauthenticate)$ {
      limit_req zone=mdm_login burst=10 nodelay;
      proxy_pass http://mdm:8080;
    }
    location ~ ^/api/(identity-host/v1/tenants/|v[123]/|mdm-candidate/v1/) { limit_req zone=mdm_api burst=20 nodelay; proxy_pass http://mdm:8080; }
    location = /livez { proxy_pass http://mdm:8080; }
    location = /readyz { proxy_pass http://mdm:8080; }
    location /api/ { return 404; }
    location / { try_files $uri $uri/ /index.html; }
  }
}

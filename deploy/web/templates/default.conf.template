map $request_uri $rss_tenant_header {
  default "";
  ~^/api/v1/identity/login(?:\?.*)?$ "${RSS_WEB_TENANT_ID}";
  ~^/api/v1/identity/refresh(?:\?.*)?$ "${RSS_WEB_TENANT_ID}";
}

map $request_uri $rss_target_audit_raw_path {
  default 0;
  "~^/api/v1/audit/tenants/(?!00000000-0000-0000-0000-000000000000)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/entries(?:\?.*)?$" 1;
}

upstream rss_primary {
  server ${RSS_WEB_PRIMARY_HOST}:${RSS_WEB_PRIMARY_PORT};
}

upstream rss_admin {
  server ${RSS_WEB_ADMIN_HOST}:${RSS_WEB_ADMIN_PORT};
}

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;
  gzip_min_length 1024;
  gzip_comp_level 6;

  location = /api/v1/runtime/inventory {
    include /etc/nginx/snippets/rss-proxy-common.conf;
    proxy_pass http://rss_admin;
  }

  location ^~ /api/v1/identity/ {
    include /etc/nginx/snippets/rss-proxy-common.conf;
    proxy_pass http://rss_primary;
  }

  location ^~ /api/v1/settings/ {
    include /etc/nginx/snippets/rss-proxy-common.conf;
    proxy_pass http://rss_primary;
  }

  location = /api/v1/audit/entries {
    include /etc/nginx/snippets/rss-proxy-common.conf;
    proxy_pass http://rss_admin;
  }

  location ~ "^/api/v1/audit/tenants/(?!00000000-0000-0000-0000-000000000000)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/entries$" {
    if ($rss_target_audit_raw_path = 0) { return 404; }
    include /etc/nginx/snippets/rss-proxy-common.conf;
    proxy_pass http://rss_admin;
  }

  location = /api { return 404; }
  location = /internal { return 404; }
  location ^~ /internal/ { return 404; }
  location = /health { return 404; }
  location ^~ /health/ { return 404; }
  location = /metrics { return 404; }
  location ^~ /metrics/ { return 404; }
  location = /healthz { return 404; }
  location ^~ /healthz/ { return 404; }
  location = /readyz { return 404; }
  location ^~ /readyz/ { return 404; }
  location /api/ { return 404; }

  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}

{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "useDefineForClassFields": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "preserve",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    "types": [],
    "baseUrl": ".",
    "paths": {
      "@rss/authorization": ["packages/authorization/src/index.ts"],
      "@rss/authorization/preview": ["packages/authorization/src/preview.ts"],
      "@rss/core": ["packages/core/src/index.ts"],
      "@rss/core/composables": ["packages/core/src/composables/index.ts"],
      "@rss/core/stores": ["packages/core/src/stores/index.ts"],
      "@rss/core/components": ["packages/core/src/components/index.ts"],
      "@rss/core/ui": ["packages/core/src/ui/index.ts"],
      "@rss/core/i18n": ["packages/core/src/i18n/index.ts"],
      "@rss/core/testing": ["packages/core/src/testing/index.ts"],
      "@rss/shared": ["packages/shared/src/index.ts"],
      "@rss/api": ["packages/api/src/index.ts"],
      "@rss/api/endpoints/audit": ["packages/api/src/endpoints/audit.ts"],
      "@rss/api/endpoints/identity": ["packages/api/src/endpoints/identity.ts"],
      "@rss/api/endpoints/runtime": ["packages/api/src/endpoints/runtime.ts"],
      "@rss/api/session": ["packages/api/src/session.ts"],
      "@rss/api/testing": ["packages/api/src/testing.ts"],
      "@rss/identity": ["packages/identity/src/index.ts"],
      "@rss/audit": ["packages/audit/src/index.ts"],
      "@rss/runtime": ["packages/runtime/src/index.ts"],
      "@rss/settings": ["packages/settings/src/index.ts"],
      "@rss/settings/preview": ["packages/settings/src/preview.ts"],
      "@rss/api/endpoints/settings": ["packages/api/src/endpoints/settings.ts"]
    }
  }
}

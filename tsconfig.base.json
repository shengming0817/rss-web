{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "useDefineForClassFields": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@rss/core": ["packages/core/src/index.ts"],
      "@rss/core/composables": ["packages/core/src/composables/index.ts"],
      "@rss/core/components": ["packages/core/src/components/index.ts"],
      "@rss/api/testing": ["packages/api/src/testing.ts"],
      "@rss/api/identity": ["packages/api/src/identity.ts"],
      "@rss/auth": ["packages/auth/src/index.ts"],
      "@rss/api/mdm": ["packages/api/src/mdm.ts"],
      "@rss/auth/session": ["packages/auth/src/session.ts"],
      "@rss/device-access/client": ["packages/device-access/src/client.ts"],
      "@rss/device-access/model": ["packages/device-access/src/model.ts"],
      "@rss/device-access/components": ["packages/device-access/src/components.ts"],
      "@rss/api/device-access": ["packages/api/src/device-access.ts"],
      "@rss/api/device-access-demo": ["packages/api/src/device-access-demo.ts"],
      "@rss/api/mdm-operations": ["packages/api/src/generated/mdm/index.ts"],
      "@rss/api/mdm-types": ["packages/api/src/generated/mdm/owners.ts"],
      "@rss/api/mdm-validators": ["packages/api/src/generated/mdm/owner-validators.ts"],
      "@rss/api/mdm-demo": ["packages/api/src/mdm-demo.ts"]
    }
  }
}

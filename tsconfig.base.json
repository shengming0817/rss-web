{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "useDefineForClassFields": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "preserve",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    "types": [],
    "baseUrl": ".",
    "paths": {
      "@gocell/core": ["packages/core/src/index.ts"],
      "@gocell/core/composables": ["packages/core/src/composables/index.ts"],
      "@gocell/core/stores": ["packages/core/src/stores/index.ts"],
      "@gocell/core/components": ["packages/core/src/components/index.ts"],
      "@gocell/core/ui": ["packages/core/src/ui/index.ts"],
      "@gocell/core/i18n": ["packages/core/src/i18n/index.ts"],
      "@gocell/core/testing": ["packages/core/src/testing/index.ts"],
      "@gocell/shared": ["packages/shared/src/index.ts"],
      "@gocell/request": ["packages/request/src/index.ts"]
    }
  }
}
